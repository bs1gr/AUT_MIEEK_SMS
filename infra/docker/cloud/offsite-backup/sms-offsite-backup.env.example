# Copy to /etc/sms-offsite-backup.env on the VM (owner root, chmod 600). Never commit the real file.
# The bucket's write-only pre-authenticated request URL, ending in /o/
OFFSITE_PAR_URL=https://objectstorage.eu-frankfurt-1.oraclecloud.com/p/REPLACE/n/REPLACE/b/sms-backups/o/
# A healthchecks.io check (period 1 day, grace 12 hours); leave empty for none
OFFSITE_PING_URL=
