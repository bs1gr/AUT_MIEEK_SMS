# Copy to .env next to docker-compose.cloud.yml on the VM and fill in. Never commit the copy.

# A new random key: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Tokens are signed with it, so a login made on the home install is not valid here and the other
# way round; people simply log in again after switching. (SMTP settings saved in the database
# folder are encrypted with a key derived from it and are per host anyway.)
SECRET_KEY=

# The QNAP PostgreSQL, reached over Tailscale. Best: Tailscale runs on the QNAP itself, then this
# is the QNAP's own tailnet address (100.x.y.z, shown by `tailscale status`) and no home PC has
# to be on. Otherwise: the QNAP's LAN address through a home subnet router (the VM then needs
# `tailscale set --accept-routes`), which works only while that router is on.
POSTGRES_HOST=100.x.y.z
# The port the QNAP's PostgreSQL container publishes (55433 on the owner's QNAP, not 5432).
POSTGRES_PORT=55433
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# The VM's MagicDNS name (tailscale status shows it). Comma-separate to add more names.
TRUSTED_HOSTS=sms-cloud.example.ts.net

# https://localhost is the Android app's WebView origin and must stay in the list.
CORS_ORIGINS=https://localhost,https://sms-cloud.example.ts.net

# Leave unset to build the image on the VM. Set only if an image was published for the release.
# SMS_IMAGE=ghcr.io/bs1gr/aut_mieek_sms:v1.x.x

# Round-trip savers for the far-away database; the compose file turns them on. To switch one
# off, uncomment its line.
# DB_PRE_PING_IDLE_SECONDS=0
# DB_AUTOCOMMIT_READS=false
# PERMISSION_CACHE_TTL_SECONDS=0

# Privacy page: who the data controller is and how to reach them (docs/admin/PRIVACY_AND_GDPR.md).
# While the first two are empty the page tells people to ask the school office.
# PRIVACY_CONTROLLER_NAME=
# PRIVACY_CONTACT=
# PRIVACY_DPO_CONTACT=
# PRIVACY_NOTICE_URL=
