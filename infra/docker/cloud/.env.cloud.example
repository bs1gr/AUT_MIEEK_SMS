# Copy to .env next to docker-compose.cloud.yml on the VM and fill in. Never commit the copy.

# A new random key: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Tokens are signed with it, so a login made on the home install is not valid here and the other
# way round; people simply log in again after switching. (SMTP settings saved in the database
# folder are encrypted with a key derived from it and are per host anyway.)
SECRET_KEY=

# The QNAP PostgreSQL as the VM sees it through Tailscale (the QNAP's LAN address, reached via
# the home subnet router; the VM must run `tailscale up --accept-routes`).
POSTGRES_HOST=172.16.0.2
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# The VM's MagicDNS name (tailscale status shows it). Comma-separate to add more names.
TRUSTED_HOSTS=sms-cloud.example.ts.net

# https://localhost is the Android app's WebView origin and must stay in the list.
CORS_ORIGINS=https://localhost,https://sms-cloud.example.ts.net

# Leave unset to build the image on the VM. Set only if an image was published for the release.
# SMS_IMAGE=ghcr.io/bs1gr/aut_mieek_sms:v1.x.x
