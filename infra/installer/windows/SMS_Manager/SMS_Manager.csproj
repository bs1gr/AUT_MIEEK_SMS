<Project Sdk="Microsoft.NET.Sdk">

  <!-- ===== Project Metadata ===== -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET 10 LTS (supported to Nov 2028). net5.0 was out of support (NETSDK1138, plan todo 33);
         net8.0 would have reached end of support in Nov 2026. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Build output configuration -->
    <AssemblyName>SMS_Manager</AssemblyName>
    <RootNamespace>SMS_Manager</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Company>AUT MIEEK</Company>
    <Product>Student Management System - Docker Manager</Product>
    <Description>Lightweight console application for managing SMS Docker containers</Description>

    <!-- Startup hook behavior -->
    <StartupObject>SMS_Manager.Program</StartupObject>

    <!-- Output and debug settings -->
    <OutputPath>..\..\dist\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- ===== Build Configurations ===== -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- ===== Dependencies ===== -->
  <!-- None: WindowsIdentity and Microsoft.Win32.Registry ship in the .NET 10 shared framework;
       the 5.0.0 packages the net5.0 build referenced are obsolete there. -->

  <!-- ===== Build Targets ===== -->
  <Target Name="PublishToInstaller" AfterTargets="Publish">
    <Copy
      SourceFiles="$(PublishDir)SMS_Manager.exe"
      DestinationFolder="..\dist\"
      SkipUnchangedFiles="true" />
    <Message Text="SMS_Manager.exe published to installer/dist/" Importance="high" />
  </Target>

</Project>
