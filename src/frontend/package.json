  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ./sync-version.cjs",
    "build": "npm run prebuild && vite build",
    "build:analyze": "npm run prebuild && vite build --mode analyze",
    "pretest": "node ../../tools/enforce-vitest-policy.cjs",
    "ci:install": "npm ci --no-audit --silent",
    "ci:build": "npm run prebuild && vite build --logLevel error",
    "preview": "vite preview",
    "test": "node --max-old-space-size=6144 ./node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\"",
    "e2e": "playwright test",
    "generate-icons": "node ../../scripts/generate-pwa-icons.js",
    "build:android": "npm run prebuild && vite build --mode android && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "cross-env CAPACITOR_ANDROID_STUDIO_PATH=\"C:\\Program Files\\Android\\Android Studio\\bin\\studio64.exe\" npx cap open android"
  },
